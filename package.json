{
  "name": "Mentiohunt",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=server --filter=web",
    "dev:server": "turbo dev --filter=server",
    "dev:web": "turbo dev --filter=web",
    "dev:scraper": "cd apps/scraper && uvicorn main:app --reload --port 8000",
    "lint": "turbo lint",
    "format": "turbo format",
    "supabase:types": "supabase gen types typescript --project-id eagakiaavexoykhvvkwc --schema public > packages/supabase/database-types.ts",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "supabase": "^2.100.1",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
